*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
release/
mapping.txt

# --- Android Studio / IntelliJ ---
*.iml
.idea/
.cxx/
.externalNativeBuild/

# --- Kotlin ---
.kotlin/

# --- Claude / AI tools ---
.claude/
CLAUDE.md
.cursor/
.aider*

# --- Operating system ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs and temporary files ---
*.log
*.tmp
*.bak
hs_err_pid*
